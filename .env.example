# xAI API key — https://console.x.ai
XAI_API_KEY=

# Supabase Postgres — from your Supabase project settings (Database → Connection string)
# DATABASE_URL: transaction-mode pooler URL (port 6543), used by the app
# DIRECT_URL: session-mode direct URL (port 5432), used for migrations
DATABASE_URL=
DIRECT_URL=

# Hard cap on spend per validation run (USD). Default 5.
IDEATEX_MAX_RUN_USD=5

# Set to 1 to run the whole pipeline against the mock LLM adapter (no API calls)
MOCK_LLM=
