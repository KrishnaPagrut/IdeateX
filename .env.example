# Copy to .env and fill in. .env is gitignored.

# xAI / Grok. Without this, LaunchLab runs entirely on the deterministic
# offline provider — every screen still works, content is seeded and repeatable.
XAI_API_KEY=

# X (Twitter) developer app — powers the real X search pass and the X connector.
# Note: these are NOT the same as XAI_API_KEY.
X_API_KEY=
X_API_SECRET=
X_BEARER_TOKEN=

# Optional overrides
# XAI_CHAT_MODEL=grok-4.5
# XAI_IMAGE_MODEL=grok-imagine-image
# XAI_TIMEOUT_MS=45000

# SQLite location
# LAUNCHLAB_DB=./launchlab.db
